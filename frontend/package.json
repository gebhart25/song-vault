{
	"name": "songvault-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"hash-wasm": "^4.13.0",
		"tus-js-client": "^4.3.1"
	}
}
